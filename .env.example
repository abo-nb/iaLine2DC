# LINE Messaging API channel
Line__ChannelId=
Line__ChannelSecret=
Line__ChannelAccessToken=

# Discord
Discord__Enabled=true
Discord__Token=
Discord__GuildId=

# Administrator Discord user IDs, comma separated
AdminIds=

# LLM providers (both configured; the active model is chosen with /set-model)
Llm__OpenAi__BaseUrl=https://api.openai.com/v1
Llm__OpenAi__ApiKey=
Llm__Google__BaseUrl=https://generativelanguage.googleapis.com
Llm__Google__ApiKey=

# MongoDB
Mongo__ConnectionString=mongodb://localhost:27017
Mongo__Database=msg2dc
